# ==============================================================================
# MODELO DE VARIABLES DE ENTORNO (.envmodelo)
# Copia este archivo a `.env` y pega tu clave privada real.
# Este archivo es solo una plantilla: tus claves reales NUNCA van a Git.
# ==============================================================================

# Clave de API de Google Gemini (requerida para el Desafío)
GOOGLE_API_KEY=tu_google_api_key_aqui

# (Opcional) Si decides probar con otros proveedores:
# OPENAI_API_KEY=tu_openai_api_key_aqui
